{
  "name": "verity",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate": "npm run contracts:artifacts && npm run generate:api-client",
    "generate:api-client": "openapi-typescript artifacts/openapi/openapi.json -o packages/sdk/src/generated.ts",
    "dev:full": "turbo dev",
    "dev": "turbo dev",
    "dev:web": "npm run dev --workspace=@verity/web",
    "dev:api": "npm run dev --workspace=@verity/api",
    "dev:worker": "npm run dev --workspace=@verity/grader-worker",
    "dev:indexer": "npm run dev --workspace=@verity/indexer",
    "test:auth": "PRIVY_APP_ID=test PRIVY_APP_SECRET=test node --import tsx --test apps/api/src/auth.test.ts",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "services:check": "node --env-file=.env scripts/services-check.mjs",
    "e2b:templates:build": "node --env-file=.env scripts/e2b-templates-build.mjs",
    "contracts:build": "cd contracts && forge build",
    "contracts:artifacts": "npm run contracts:build && node scripts/generate-contract-artifacts.mjs",
    "contracts:test": "cd contracts && forge test",
    "contracts:deploy:monad-testnet": "node --env-file=.env scripts/deploy-monad-testnet.mjs",
    "contracts:verify:source": "node --env-file=.env scripts/verify-contract-source.mjs",
    "contracts:verify:deployment": "node --env-file=.env scripts/verify-deployment.mjs",
    "build": "npm run build --workspace=@verity/web",
    "test": "npm run test --workspaces --if-present",
    "test:contracts": "cd contracts && forge test",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "artifacts:check": "node scripts/check-artifacts.mjs"
  },
  "devDependencies": {
    "@e2b/cli": "^2.15.1",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "openapi-typescript": "^7.13.0",
    "turbo": "^2.5.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "e2b": "^2.36.0",
    "viem": "^2.55.8"
  }
}
