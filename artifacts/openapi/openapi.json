{
  "openapi": "3.1.0",
  "info": { "title": "Verity API", "version": "0.3.0" },
  "components": { "securitySchemes": { "privyBearer": { "type": "http", "scheme": "bearer", "bearerFormat": "Privy access token" } }, "schemas": { "ScoreSchema": { "type": "object", "required": ["passingScore", "scoreScale"], "properties": { "passingScore": { "type": "string", "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$" }, "minScore": { "type": "string" }, "maxScore": { "type": "string" }, "scoreScale": { "type": "integer", "description": "Positive power-of-ten multiplier for exact Solidity integer settlement." }, "scoreUnit": { "type": "string" } } }, "PrivateGraderInput": { "type": "object", "required": ["language", "runtimeVersion", "entrypoint"], "properties": { "language": { "enum": ["typescript", "javascript", "python"] }, "runtimeVersion": { "type": "string" }, "entrypoint": { "type": "string" }, "graderSource": { "type": "string", "description": "Pasted private source; never returned." }, "graderSourceBase64": { "type": "string", "description": "Private uploaded source bytes; never returned." }, "graderFileName": { "type": "string" }, "graderConfig": { "type": "object" } } } } },
  "paths": { "/api/challenges": { "post": { "summary": "Create a company-owned challenge with private grader source", "security": [{ "privyBearer": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/PrivateGraderInput" }, { "type": "object", "required": ["title", "description", "tags", "agentContext", "rewardWei", "maxSubmissions", "deadline", "chainId", "scoring"], "properties": { "title": { "type": "string" }, "description": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "agentContext": { "type": "string" }, "rewardWei": { "type": "string" }, "maxSubmissions": { "type": "integer" }, "deadline": { "type": "string", "format": "date-time" }, "chainId": { "type": "integer" }, "scoring": { "$ref": "#/components/schemas/ScoreSchema" } } }] } }, "multipart/form-data": { "schema": { "type": "object", "properties": { "graderFile": { "type": "string", "format": "binary" } } } } } }, "responses": { "201": { "description": "Created; the response excludes private grader source and config." }, "400": { "description": "Invalid score schema, source, entrypoint, encoding, or upload." } } } }, "/api/challenges/{challengeId}": { "get": { "summary": "Public challenge projection; excludes grader source, config, and runtime details", "parameters": [{ "name": "challengeId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Challenge" } } } } }
}
